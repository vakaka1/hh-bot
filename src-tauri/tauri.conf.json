{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HH-bot",
  "version": "0.1.0",
  "identifier": "ru.hhbot.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HH-bot",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.hh.ru https://hh.ru; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": ["icons/icon.png"]
  }
}
