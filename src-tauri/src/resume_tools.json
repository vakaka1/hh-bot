    "type": "function",
    "function": {
      "name": "resume_reference",
      "description": "Получить справочники для резюме. Для условий kind=conditions укажи resume_id: требования и шаги читаются из мобильного профиля существующего черновика. Для areas/professional_roles нужен query. Не угадывай id. kind=profile с resume_id возвращает существующее образование с id записей и текущие значения, чтобы корректно редактировать их. kind=skill_levels с resume_id возвращает ID, текущие уровни профессиональных навыков и доступные уровни.",
      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "conditions",
              "dictionaries",
              "professional_roles",
              "areas",
              "languages",
              "profile",
              "skill_levels"
            ]
          },
          "query": {
            "type": "string"
          },
          "resume_id": {
            "type": "string",
            "description": "Для kind=conditions обязателен id существующего черновика. Чтение не создаёт черновик."
          }
        },
        "required": [
          "kind"
        ]
      }
    }
  },
